{
  "expo": {
    "name": "MyFirstProject",
    "slug": "MyFirstProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myfirstproject",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.anonymous.MyFirstProject"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MyFirstProject"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "name": "Abeysone",
      "shortName": "Abeysone",
      "themeColor": "#F1E7DF",
      "backgroundColor": "#F1E7DF",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to mark attendance with face recognition and photograph workers, assets, and documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach worker, asset, and document images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to attach worker, asset, and document images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach worker, asset, and document images.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save generated reports and exports to your photo library."
        }
      ],
      "expo-document-picker",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}